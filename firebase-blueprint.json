{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "A detailed clinical patient record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "serialNo": { "type": "number" },
        "serNo": { "type": "string" },
        "serviceCategory": { "type": "string", "enum": ["Ser", "Vet", "Dep"] },
        "admissionNo": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "date": { "type": "string", "format": "date" },
        "tmt": { "type": "string", "enum": ["NA", "+", "-"] },
        "ejectionFraction": { "type": "string", "enum": ["Normal", "Mild LVSD", "Moderate LVSD", "Severe LVSD", "LVH", "HCM", "HOCM", "Other"] },
        "otherEjectionFractionNotes": { "type": "string" },
        "rwma": { "type": "array", "items": { "type": "string" } },
        "comorbidities": { "type": "array", "items": { "type": "string" } },
        "labPhotoUrl": { "type": "string" },
        "phoneNumbers": { "type": "array", "items": { "type": "string" } },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "bmi": { "type": "number" },
        "access": { "type": "string", "enum": ["Rt radial", "Lt radial", "Rt femoral", "Lt femoral", "Other"] },
        "usgDoppler": { "type": "boolean" },
        "angiogramPhotoUrl": { "type": "string" },
        "pciPhotoUrl": { "type": "string" },
        "imaging": { "type": "array", "items": { "type": "string" } },
        "imagingPhotoUrl": { "type": "string" },
        "specialHardware": { "type": "array", "items": { "type": "string" } },
        "complications": { "type": "array", "items": { "type": "string" } },
        "complicationsCustom": { "type": "string" },
        "otherHardware": { "type": "array", "items": { "type": "string" } },
        "otherHardwareNotes": { "type": "string" },
        "otherAccessNotes": { "type": "string" },
        "drugs": { "type": "array", "items": { "type": "string" } },
        "finalNotes": { "type": "string" },
        "otherInfoPhotoUrl": { "type": "string" },
        "notes": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "bifurcation": { "type": "boolean" },
        "isOther": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string" },
        "lesions": { "type": "array", "items": { "type": "string" } },
        "stentDetails": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["serialNo", "serNo", "serviceCategory", "admissionNo", "name", "age", "gender", "date", "tmt", "ejectionFraction", "labPhotoUrl", "phoneNumbers", "access", "usgDoppler", "angiogramPhotoUrl", "pciPhotoUrl", "imaging", "imagingPhotoUrl", "specialHardware", "complications", "otherHardware", "otherHardwareNotes", "otherAccessNotes", "drugs", "finalNotes", "otherInfoPhotoUrl", "notes", "category", "tags", "bifurcation", "isOther", "createdAt", "createdBy"]
    },
    "Counter": {
      "title": "Counter",
      "description": "Atomic counter for sequential IDs",
      "type": "object",
      "properties": {
        "count": {
          "type": "number"
        }
      },
      "required": ["count"]
    },
    "PrintPreset": {
      "title": "PrintPreset",
      "description": "Saved print layout configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "headerTitle": { "type": "string" },
        "showHospitalHeader": { "type": "boolean" },
        "textSizeScale": { "type": "string", "enum": ["compact", "normal", "large"] },
        "visibleSections": {
          "type": "object",
          "properties": {
            "demographics": { "type": "boolean" },
            "diagnostics": { "type": "boolean" },
            "anatomy": { "type": "boolean" },
            "pci": { "type": "boolean" },
            "outcomes": { "type": "boolean" },
            "photos": { "type": "boolean" },
            "signatures": { "type": "boolean" }
          },
          "required": ["demographics", "diagnostics", "anatomy", "pci", "outcomes", "photos", "signatures"]
        },
        "physicianName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "headerTitle", "showHospitalHeader", "textSizeScale", "visibleSections", "physicianName", "createdAt", "createdBy"]
    }
  },
  "firestore": {
    "patients": {
      "schema": "Patient",
      "description": "Collection of patient records"
    },
    "counters": {
      "schema": "Counter",
      "description": "Counters for generating serial numbers"
    },
    "print_presets": {
      "schema": "PrintPreset",
      "description": "Collection of saved print presets"
    }
  }
}
